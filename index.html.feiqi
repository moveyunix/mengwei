                "journey.item3.company": "ZTE Corporation",
                "journey.item3.desc": "Overall responsible for standards and open source strategy. Published dozens of standards in IETF, ITU, etc., and holds 30+ authorized patents as first author. Served as PTL of OpenDaylight OF-CONFIG in 2015, and as Mentor in Adlik/Co-Sight since 2019.",
                "journey.item4.title": "LF AI &amp; Data Board Chair",
                "journey.item4.company": "Linux Foundation",
                "journey.item4.desc": "Served as Chair for two consecutive years, coordinating 13 Premier Members including AWS, Microsoft, Huawei, Intel, helping the foundation become one of the largest AI open source communities globally.",
                "journey.item5.title": "Secretary-General, COIA",
                "journey.item5.company": "COIA",
                "journey.item5.desc": "Co-founded the alliance with 50+ organizations, leveraging open source to drive AI adoption across industries, with membership now exceeding 60.",
                "journey.item6.title": "Secretary-General, OAAIF",
                "journey.item6.company": "OAAIF",
                "journey.item6.desc": "Founded the foundation with 20+ organizations, establishing dual headquarters and three regional centers to foster global agent technology ecosystem.",
                "contact.label": "Digital Twin",
                "contact.title": "Chat with My Digital Twin",
                "contact.desc": "Click the button below to start an AI-driven conversation with my digital twin — based on my public views and industry insights, available 24/7.",
                "contact.btn": "Start Chat",
                "contact.note": '<i class="fas fa-shield-alt"></i> Digital twin is built on open source LLMs for learning and exchange purposes only',
                "footer.copyright": "&copy; 2026 Meng Wei · Open Source Strategy · Industry Ecosystem",
                "footer.built": 'Built with <i class="fas fa-heart" style="color:#ef4444;"></i> for open source'
            }
        };

        // ---------- 核心逻辑 ----------
        let currentLang = localStorage.getItem('lang') || 'zh'; // 默认中文
        const toggleBtn = document.getElementById('langToggle');

        function setLanguage(lang) {
            currentLang = lang;
            localStorage.setItem('lang', lang);
            render();
            toggleBtn.textContent = lang === 'zh' ? 'EN' : '中文';
        }

        function render() {
            const elements = document.querySelectorAll('[data-i18n]');
            elements.forEach(el => {
                const key = el.getAttribute('data-i18n');
                const translation = i18n[currentLang]?.[key];
                if (translation !== undefined) {
                    // 如果包含HTML标签，使用innerHTML，否则使用textContent
                    // 为了安全，我们统一使用innerHTML，但确保内容可信
                    el.innerHTML = translation;
                }
            });
        }

        // 切换语言
        toggleBtn.addEventListener('click', function() {
            const nextLang = currentLang === 'zh' ? 'en' : 'zh';
            setLanguage(nextLang);
        });

        // 初始化：设置默认语言按钮文字
        setLanguage(currentLang); // 会调用render

        // 数字分身按钮演示
        document.getElementById('digitalTwinBtn')?.addEventListener('click', function(e) {
            e.preventDefault();
            alert(currentLang === 'zh' ? '🤖 数字分身对话功能即将上线！\n（当前为演示版本，欢迎联系真实本人交流）' : '🤖 Digital twin chat coming soon!\n(This is a demo, feel free to reach out to the real person.)');
        });

        // 平滑滚动
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                const href = this.getAttribute('href');
                if (href === '#') return;
                e.preventDefault();
                const target = document.querySelector(href);
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });
    })();
</script>

</body>
</html>
